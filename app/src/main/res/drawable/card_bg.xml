<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item android:left="-3dp" android:top="-3dp" android:right="-3dp" android:bottom="-3dp">
                <shape android:shape="rectangle">
                    <solid android:color="#3322D3EE" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#14307A" />
                    <stroke android:width="2dp" android:color="#22D3EE" />
                    <corners android:radius="15dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#CC0B1838" />
            <stroke android:width="1dp" android:color="#1F3A70" />
            <corners android:radius="15dp" />
        </shape>
    </item>
</selector>
